@using Moodry.Models.ViewModels
@model EntryViewModel

<div class="w-100">
    <h5 class="card-subtitle text-center fw-semibold">Ready to save?</h5>
    <hr />
    
    <div class="review-section">
        <div class="mb-3">
            <strong>Date & Time:</strong>
            <p id="preview-datetime" class="mb-0"></p>
        </div>
        
        <div class="mb-3">
            <strong>Mood:</strong>
            <p id="preview-mood" class="mb-0"></p>
        </div>
        
        <div class="mb-3">
            <strong>Activities:</strong>
            <div id="preview-activities" class="mb-0"></div>
        </div>
        
        <div class="mb-3">
            <strong>Notes:</strong>
            <p id="preview-notes" class="mb-0"></p>
        </div>
    </div>

    <div class="form-group mt-4 d-flex justify-content-between">
        <button type="button" class="btn btn-custom-back previous">Previous</button>
        <button type="submit" class="btn btn-custom-next">Submit Entry</button>
    </div>
</div>