@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isHomeActive = currentController == "Home" && currentAction == "Index" ? "active" : "";
    var isEntriesActive = currentController == "Home" && currentAction == "Entries" ? "active" : "";
    var isMoodActive = currentController == "Home" && currentAction == "Mood" ? "active" : "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Moodry</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Moodry.styles.css" asp-append-version="true" />
</head>

<body>
    @if (User.Identity.IsAuthenticated) {
        <!-- Mobiili -->
        <nav class="navbar d-flex d-md-none text-white justify-content-between">
            <h2 class="ps-4 my-1">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">    
                    <img src="~/icons/logo.svg" id="logo" height="30" alt="Moodry logo" />
                </a>
            </h2>
            
            <div class="pe-4 d-flex align-items-center gap-2 text-white">
                <h5 class="m-0">Hello, @User.Identity.Name!</h5>
                <form asp-controller="Login" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-custom-nav">Logout</button>
                </form>
            </div>
        </nav>
    
        <div class="d-md-flex">
            <!-- Desktop sidebar -->
            <nav class="sidebar d-none d-md-flex flex-column flex-shrink-0 p-3 h-100">
                <h2>
                   <a class="navbar-brand ps-2" asp-controller="Home" asp-action="Index">    
                        <img src="~/icons/logo.svg" height="40" alt="Moodry logo" />
                    </a>
                </h2>
                <h5 class="m-0 pb-3 ps-2">Hello, @User.Identity.Name!</h5>

                <div class="navMood ps-2 @isMoodActive">
                    <h5 class="fw-light">How are you feeling today?</h5>
                    <a role="button" class="btn btn-custom-nav w-100 " asp-controller="Home" asp-action="Mood">+</a>
                </div>
                <hr>

                <a class="nav-link py-2 ps-2 d-flex justify-content-start text-white @isHomeActive" asp-controller="Home" asp-action="Index">
                   <img src="~/icons/home.svg" height="25" alt="Moodry logo" />
                   <h5 class="ps-2 pt-1">Home</h5>
                </a>
                <a class="nav-link py-2 ps-2 d-flex justify-content-start text-white @isEntriesActive" asp-controller="Home" asp-action="Entries">
                    <img src="~/icons/entries.svg" height="25"  alt="Moodry logo" />
                    <h5 class="ps-2 pt-1">Entries</h5>
                </a>
                <ul class="nav nav-pills flex-column mt-auto">
                    <li class="nav-item">
                        <form asp-controller="Login" asp-action="Logout" method="post">
                            <button type="submit" class="btn btn-custom-nav my-3 py-1 w-100">Logout</button>
                        </form>
                    </li>
                </ul>
            </nav>

             <div class="flex-grow-1 tausta">
                <main class="pt-4 mb-2">
                    @RenderBody()
                </main>
            </div>
        </div>

        <footer class="mt-4 fixed-bottom text-white d-md-none d-block">
            <div class="container-fluid">
                <div class="row text-center justify-content-center align-items-center">

                    <div class="col-3 fw-semibold">
                        <a class="nav-link text-white @isHomeActive" asp-controller="Home" asp-action="Index">
                            <img src="~/icons/home.svg" height="20" class="pb-1" />
                            <h6 class="m-0">Home</h6>
                        </a>
                    </div>

                    <div class="navMood col-6 col-sm-4 @isMoodActive">
                        <a role="button" class="btn btn-custom-nav w-100" asp-controller="Home" asp-action="Mood">
                            <h2 class="m-0 fw-semibold">+</h2>
                        </a>
                    </div>

                    <div class="col-3 fw-semibold">
                        <a class="nav-link text-white @isEntriesActive" asp-controller="Home" asp-action="Entries">
                            <img src="~/icons/entries.svg" height="20" class="pb-1" />
                            <h6 class="m-0">Entries</h6>
                        </a>
                    </div>

                </div>
            </div>
        </footer>
     }
          
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
   ´<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>                                      