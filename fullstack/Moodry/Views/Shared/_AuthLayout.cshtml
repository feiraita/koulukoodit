<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Moodry</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Moodry.styles.css" asp-append-version="true" />
</head>

<body>
    <header class="text-white d-flex justify-content-center w-100">
        <h2 class="pb-2 pt-3">
                <a class="navbar-brand" asp-controller="Login" asp-action="Index">    
                    <img src="~/icons/logo.svg" id="logo" height="50" alt="Moodry logo" />
                </a>
            </h2>
    </header>

    <main class="flex-grow-1 login-tausta">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>                                      