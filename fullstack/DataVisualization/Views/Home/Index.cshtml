@using DataVisualisation.Models
@model StatsViewModel
@{
    ViewData["Title"] = "Home Page";
}

<div class="w-75">
    <canvas id="my2Chart"></canvas>
</div>

<div class="w-50">
    <canvas id="myChart"></canvas>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const ctx = document.getElementById('myChart');

    new Chart(ctx, {
      type: 'bar',
      data: {
        labels: @Html.Raw(Model.GetGPM_Labels),
        datasets: [{
          label: 'Games played',
          data: @(Model.GetGPM_Data),
          borderWidth: 1
        }]
      },
      options: {
        scales: {
          y: {
            beginAtZero: true
          }
        }
      }
    });
</script>

<script>
    const ctx2 = document.getElementById('my2Chart');

    new Chart(ctx2, { 
        type: 'line',
        data: { 
            labels: @Html.Raw(Model.GetGPM_Labels),
            datasets: [
                {
                    label: 'Games played',
                    data: @(Model.GetGPM_Data),
                    fill: false,
                    borderColor: 'rgb(75, 192, 192)',
                }, {
                    label: 'My First Dataset',
                    data: [65, 59, 80, 81, 500, 55, 40, 100, 230 ],
                    fill: false,
                    borderColor: 'rgb(125, 125, 255)',
                    tension: 0.1
                }
            ]},
        options: {
        scales: {
          y: {
            beginAtZero: true
          }
        }
      }
    });
</script>